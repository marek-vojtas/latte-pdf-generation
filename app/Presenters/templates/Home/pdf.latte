<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
</head>
<body>

<table class="header-table">
    <tr>
        <td style="width: 55%; vertical-align: top;">
            <div class="company-title">DEMO: PDF GENERATION</div>
            <div class="company-sub">Digital Signature Capture & mPDF Export Module</div>
            <div class="company-sub">Nette Framework &bull; PHP 8.3</div>
        </td>
        <td class="doc-badge" style="width: 45%;">
            <div class="doc-type">Service Protocol</div>
            <div class="doc-num">No: {$protocolNumber}</div>
            <div style="font-size: 8.5pt; color: #64748b; margin-top: 3px;">Date: {$protocolDate}</div>
        </td>
    </tr>
</table>

<table class="info-table">
    <tr>
        <td class="info-card">
            <div class="info-title">Sales Representative</div>
            <div class="info-content">
                <strong>{$representativeName}</strong><br>
                <span>Authorized Company Representative</span>
            </div>
        </td>
        <td style="width: 4%;"></td>
        <td class="info-card">
            <div class="info-title">Customer / Receiving Party</div>
            <div class="info-content">
                <strong>{$customerName}</strong><br>
                <span>Client Signatory</span>
            </div>
        </td>
    </tr>
</table>

<div class="section-header">Description of Work Performed</div>
<div class="work-box">
    {$workDescription|breaklines}
</div>

<table class="signatures-table">
    <tr>
        <td class="signature-col">
            <div class="signature-label">Handed Over By (Sales Representative)</div>
            <div class="signature-img-wrap">
                {if !empty($representativeSignature)}
                    <img n:attr="src: $representativeSignature" class="signature-img" alt="Sales Representative Signature">
                {else}
                    <div class="signature-line"></div>
                {/if}
            </div>
            <div class="signature-name">{$representativeName}</div>
            <div class="audit-meta">Signed on: {$signedAt}</div>
        </td>
        <td style="width: 4%;"></td>
        <td class="signature-col">
            <div class="signature-label">Accepted and Signed By (Customer)</div>
            <div class="signature-img-wrap">
                {if !empty($customerSignature)}
                    <img n:attr="src: $customerSignature" class="signature-img" alt="Customer Signature">
                {else}
                    <div class="signature-line"></div>
                {/if}
            </div>
            <div class="signature-name">{$customerName}</div>
            <div class="audit-meta">Signed on: {$signedAt}</div>
        </td>
    </tr>
</table>

<htmlpagefooter name="docFooter">
    <div class="footer">
        {syntax off}Paperless Document Engine &bull; Page {PAGENO} of {nbpg}{/syntax}
    </div>
</htmlpagefooter>
<sethtmlpagefooter name="docFooter" value="on" />

</body>
</html>
